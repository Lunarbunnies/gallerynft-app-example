# Database driver: mysql | sqlite
DB_DRIVER=sqlite

# MySQL connection string
# Example (MAMP): mysql://root:root@127.0.0.1:8889/onchain_gallery
DATABASE_URL=

# SQLite file path (used when DB_DRIVER=sqlite)
SQLITE_PATH=./dev.sqlite

# disabled | preferred | required
DB_SSL_MODE=disabled

# Optional Redis (BullMQ). Leave unset to run without Redis.
REDIS_URL=

# Alchemy API key for EVM token URI lookups
ALCHEMY_API_KEY=

# Path to mock events file
MOCK_EVENTS_PATH=mock/events.json

# Optional wallet/contract mode for GalleryNFT writes.
# Sepolia defaults are set below for local/testnet development.
# Do not put private keys or API secrets in NEXT_PUBLIC_* values.
#
# Use a GalleryNFTFactory address to let users deploy their own GalleryNFT collection contracts.
# Public Sepolia v1.1 factory for testing:
NEXT_PUBLIC_GALLERYNFT_FACTORY_ADDRESS=0x8aD86A5479DA48387f019b11B369Dd7B2D16B7DD
NEXT_PUBLIC_GALLERYNFT_FACTORY_VERSION=1.1.0

# Optional fallback: one preconfigured GalleryNFT collection contract.
# Paste your own Sepolia GalleryNFT collection address here if you are not using a factory.
NEXT_PUBLIC_GALLERYNFT_ADDRESS=
NEXT_PUBLIC_GALLERYNFT_CHAIN_ID=11155111
NEXT_PUBLIC_GALLERYNFT_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Optional chain indexer cache. This is a rebuildable projection of on-chain events.
# Set INDEXER_SOURCE=chain when running the indexer against Sepolia/mainnet.
INDEXER_SOURCE=mock
INDEXER_RPC_URL=
# Multiple factories are supported. Optional per-factory start blocks use @block.
# Public Sepolia v1.1 factory deployment block:
INDEXER_FACTORY_ADDRESSES=0x8aD86A5479DA48387f019b11B369Dd7B2D16B7DD@10974606
INDEXER_FACTORY_ADDRESS=
INDEXER_COLLECTION_ADDRESSES=
INDEXER_START_BLOCK=0
INDEXER_BLOCK_SPAN=10000
INDEXER_CONFIRMATIONS=12
INDEXER_POLL_MS=15000

# Optional server-side contract verification worker.
# Keep ETHERSCAN_API_KEY server-side only; never expose it as NEXT_PUBLIC_*.
ETHERSCAN_API_KEY=
VERIFIER_PROTOCOL_DIR=../gallerynft-protocol
VERIFIER_NETWORK=sepolia
VERIFIER_POLL_MS=60000
VERIFIER_MAX_ATTEMPTS=5
VERIFIER_TIMEOUT_MS=180000
