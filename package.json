{
  "name": "onchain-gallery",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "npm install --prefix shared && npm install --prefix indexer && npm install --prefix web",
    "dev": "npm run dev:web",
    "dev:legacy": "concurrently \"npm run dev:web\" \"npm run dev:indexer\"",
    "dev:web": "cd web && npm run dev",
    "dev:indexer": "cd indexer && npm run dev",
    "dev:verifier": "cd indexer && npm run dev:verifier",
    "index:catchup": "cd indexer && npm run catchup",
    "db:migrate": "node db/migrate.js",
    "index:reset": "node scripts/resetChainIndex.js",
    "mock:seed": "node scripts/mockSeed.js",
    "metadata:backfill": "node scripts/backfillMetadata.js",
    "rebuild:native": "npm rebuild better-sqlite3",
    "build:web": "cd web && npm run build",
    "build:indexer": "cd indexer && npm run build",
    "build": "npm run build:web && npm run build:indexer",
    "check:shared": "npm --prefix shared run test && npm --prefix shared run build",
    "check:indexer": "npm --prefix indexer run build",
    "check": "npm run check:shared && npm run build:web && npm run check:indexer && npm run mock:seed"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "concurrently": "^9.0.0"
  }
}
